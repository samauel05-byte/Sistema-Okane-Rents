// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Owner {
  id         String      @id @default(cuid())
  name       String
  email      String?
  phone      String?
  rnc        String?
  notes      String?
  createdAt  DateTime    @default(now())
  apartments Apartment[]
  expenses   Expense[]
  invoices   Invoice[]
}

model Apartment {
  id          String    @id @default(cuid())
  label       String
  address     String?
  rentAmount  Float
  currency    String    @default("DOP")
  // Day of the month (1-31) rent is due; null = not tracked.
  paymentDueDay Int?
  // Late fee charged when overdue, as a % of the rent (0-10) — varies by
  // owner, so it's just a plain configurable value rather than a fixed rule.
  lateFeePercent Float?
  owner       Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String
  createdAt   DateTime  @default(now())
  tenants     Tenant[]
  payments    Payment[]
  expenses    Expense[]
  invoices    Invoice[]
  userAccess  UserApartmentAccess[]
}

model Tenant {
  id          String     @id @default(cuid())
  name        String
  email       String?
  phone       String?
  rnc         String?
  active      Boolean    @default(true)
  moveInDate  DateTime?
  apartment   Apartment  @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  apartmentId String
  createdAt   DateTime   @default(now())
  payments    Payment[]
  invoices    Invoice[]
}

// A rent payment collected from a tenant, attributed to the month it covers.
model Payment {
  id          String    @id @default(cuid())
  amount      Float
  currency    String    @default("DOP")
  paidOn      DateTime  @default(now())
  periodMonth Int
  periodYear  Int
  method      String?
  notes       String?
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId    String
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  apartmentId String
  createdAt   DateTime  @default(now())
  // Receipt auto-generated for this payment, if any.
  invoice     Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceId   String?   @unique
}

// A cost paid on behalf of the owner (repairs, maintenance, etc.) that
// reduces the amount owed to them for the month it's attributed to.
model Expense {
  id          String     @id @default(cuid())
  description String
  amount      Float
  currency    String     @default("DOP")
  incurredOn  DateTime   @default(now())
  periodMonth Int
  periodYear  Int
  category    String?
  owner       Owner      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String
  apartment   Apartment? @relation(fields: [apartmentId], references: [id], onDelete: SetNull)
  apartmentId String?
  createdAt   DateTime   @default(now())
}

// A role is a named, admin-editable set of permissions. Built-in roles
// (Administrador, Gestor) are just rows here too — admins can edit them
// or create new ones ("perfiles") from the UI without any code change.
model Role {
  id                 String   @id @default(cuid())
  name               String   @unique
  description        String?
  // Whether users with this role see/operate on every apartment, or only
  // the ones explicitly granted via UserApartmentAccess.
  scopeAllApartments Boolean  @default(false)
  manageUsers        Boolean  @default(false)
  manageOwners       Boolean  @default(false)
  manageApartments   Boolean  @default(false)
  managePayments     Boolean  @default(false)
  manageExpenses     Boolean  @default(false)
  manageInvoices     Boolean  @default(false)
  viewReports        Boolean  @default(false)
  createdAt          DateTime @default(now())
  users              User[]
}

model User {
  id             String               @id @default(cuid())
  username       String               @unique
  passwordHash   String
  name           String
  active         Boolean              @default(true)
  role           Role                 @relation(fields: [roleId], references: [id])
  roleId         String
  apartmentAccess UserApartmentAccess[]
  sessions       Session[]
  createdAt      DateTime             @default(now())
}

// Grants a user (with a restricted-scope role) access to one apartment.
// Irrelevant for roles with scopeAllApartments = true.
model UserApartmentAccess {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  apartmentId String
  createdAt   DateTime  @default(now())

  @@unique([userId, apartmentId])
}

model Session {
  token     String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Business identity used as the header/issuer on every printed invoice or
// receipt, plus the running consecutive-number counters. Single row.
model BusinessSettings {
  id                String   @id @default("singleton")
  businessName      String?
  businessRnc       String?
  address           String?
  phone             String?
  email             String?
  logoDataUrl       String?
  faviconDataUrl    String?
  nextReceiptNumber Int      @default(1)
  nextInvoiceNumber Int      @default(1)
  updatedAt         DateTime @updatedAt
}

// A printable receipt (to a tenant, confirming a rent payment) or invoice
// (to an owner, billing for management services). "type" picks which.
model Invoice {
  id          String     @id @default(cuid())
  type        String // "TENANT" (recibo de pago) | "OWNER" (factura de gestión)
  number      Int
  ncf         String?
  issuedOn    DateTime   @default(now())
  concept     String
  amount      Float
  currency    String     @default("DOP")
  // Whether ITBIS (18%, RD VAT) is added on top of "amount" when displayed.
  applyItbis  Boolean    @default(false)
  clientName  String
  clientRnc   String?
  notes       String?
  periodMonth Int?
  periodYear  Int?
  owner       Owner?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId     String?
  apartment   Apartment? @relation(fields: [apartmentId], references: [id], onDelete: SetNull)
  apartmentId String?
  tenant      Tenant?    @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  tenantId    String?
  createdAt   DateTime   @default(now())
  payment     Payment?
}
